{
  "name": "heroterm",
  "version": "0.2.5",
  "description": "A terminal in your browser where every command gets its own window. Your real shell, told to explain itself.",
  "license": "MIT",
  "author": "Jin Wang",
  "homepage": "https://github.com/yokeholy/heroterm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yokeholy/heroterm.git"
  },
  "bugs": {
    "url": "https://github.com/yokeholy/heroterm/issues"
  },
  "keywords": [
    "terminal",
    "shell",
    "pty",
    "xterm",
    "zsh",
    "osc-133",
    "web-terminal",
    "claude-code",
    "browser-terminal"
  ],
  "bin": {
    "heroterm": "bin/heroterm.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "public/",
    "server.js",
    "history.js",
    "fonts.js",
    "shell/heroterm-remote.sh",
    "shell/zdotdir/.zshenv",
    "shell/zdotdir/.zprofile",
    "shell/zdotdir/.zshrc"
  ],
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "postinstall": "node scripts/fix-spawn-helper.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^4.19.2",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  }
}
